    {
      "id": "offer",
      "type": "character_scene",
      "narration": "Here is the real secret. He is your partner, not your boss. He offers you a deal and a fat bag of money. But you are never once forced to say yes.",
      "visual": {
        "title": "Partner, not boss",
        "elements": [
          {
            "kind": "figure",
            "id": "market2",
            "cast": "max",
            "at": { "col": 6, "row": 1, "w": 4, "h": 5 },
