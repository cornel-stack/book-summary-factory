        "number": 1,
        "title": "The Intelligent Investor",
        "emphasis": "underline",
        "sync": { "phrase": "Intelligent Investor" }
      }
    },
    {
      "id": "meet",
      "type": "character_scene",
      "narration": "Imagine a business partner named Mr. Market. Every single day he strolls up, knocks on your door, and shouts out a price.",
      "visual": {
        "title": "Meet Mr. Market",
        "elements": [
          {
            "kind": "figure",
            "id": "market",
            "cast": "max",
            "at": { "col": 5, "row": 1, "w": 4, "h": 5 },
