    },
    {
      "id": "graham-quote",
      "type": "quote_card",
      "narration": "As Benjamin Graham put it, the intelligent investor is a realist who sells to optimists and buys from pessimists.",
      "visual": {
        "quote": "The intelligent investor is a realist who sells to optimists and buys from pessimists.",
        "attribution": "Benjamin Graham",
        "cast": "sage"
      }
    },
    {
      "id": "moods",
      "type": "character_scene",
      "narration": "But his moods swing wildly. One moment he feels euphoric and celebrates. The next, terrible news leaves him shocked. And soon he panics completely. Yet none of this changes what the business is really worth.",
      "visual": {
        "title": "His wild moods",
        "elements": [
          {
            "kind": "figure",
            "id": "market3",
            "cast": "max",
            "at": { "col": 4, "row": 1, "w": 4, "h": 5 },
            "poses": ["celebrating", "standing", "panicking"],
            "expressions": [
              "happy",
              { "value": "shocked", "sync": { "phrase": "terrible news" } },
              { "value": "worried", "sync": { "phrase": "he panics" } }
            ],
            "label": "same guy",
            "effects": [
              { "kind": "sparkles", "sync": { "phrase": "feels euphoric" } },
              { "kind": "exclamation", "sync": { "phrase": "terrible news" } },
              { "kind": "sweat_drop", "sync": { "phrase": "he panics" } },
              { "kind": "shake", "sync": { "phrase": "panics completely" } }
            ]
          }
        ]
      }
    },
    {
      "id": "swings",
      "type": "stat_chart",
      "narration": "Look at his price over a single year. It leapt from one hundred, up to one forty two, crashed down to seventy eight, then settled near one fifteen.",
