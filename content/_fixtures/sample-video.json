            "kind": "figure",
            "id": "you2",
            "cast": "alex",
            "at": { "col": 1, "row": 1, "w": 3, "h": 5 },
            "facing": "right",
            "pose": "standing",
            "expressions": [
              "curious",
              { "value": "worried", "sync": { "phrase": "forced to say yes" } }
