    {
      "id": "trick",
      "type": "character_scene",
      "narration": "The trick is simple to say. When the crowd is fearful, that is your moment to buy. A good idea and a patient bag of money will beat the panic every time.",
      "visual": {
        "title": "The simple trick",
        "elements": [
          {
            "kind": "figure",
            "id": "investor",
            "cast": "alex",
            "at": { "col": 1, "row": 1, "w": 3, "h": 5 },
            "poses": ["thinking", "presenting"],
            "expressions": [
              "curious",
              { "value": "happy", "sync": { "phrase": "your moment to buy" } }
            ],
            "label": "buy the fear",
            "effects": [
              { "kind": "thought_bubble", "sync": { "phrase": "simple to say" } },
              { "kind": "nod", "sync": { "phrase": "moment to buy" } }
            ]
