{
  "name": "book-summary-video-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven YouTube video factory for book-summary / self-improvement content.",
  "type": "module",
  "scripts": {
    "build:video": "tsx pipeline/build.ts",
    "audio": "python3 pipeline/generate_audio.py",
    "manifest": "tsx pipeline/build_manifest.ts",
    "captions": "tsx pipeline/build_captions.ts",
    "package": "tsx pipeline/package.ts",
    "studio": "remotion studio remotion/src/index.ts",
    "render": "remotion render remotion/src/index.ts Main",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/paths": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
